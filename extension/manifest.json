{
  "manifest_version": 3,
  "name": "Prediction Bot Hook",
  "version": "1.2",
  "description": "Forwards Twitch prediction events from open Twitch tabs to the local Prediction Bot app.",
  "permissions": ["alarms"],
  "host_permissions": ["*://*.twitch.tv/*", "http://127.0.0.1/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "prediction-bot-hook@local", "strict_min_version": "128.0" }
  }
}
